APP_NAME=BanglayChinese
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# In production this MUST be the public HTTPS URL (used for signed/queued links and emails).
# APP_URL=https://banglaychinese.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database (use database for multi-server setups)

BCRYPT_ROUNDS=12

# Admin user password for `php artisan db:seed` (database/seeders/AdminUserSeeder.php).
# REQUIRED when APP_ENV=production — seeding aborts if this is empty.
ADMIN_PASSWORD=

# Production: 'error' or 'warning' keeps the logs small and hides request noise.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production: use MySQL (Hostinger) — uncomment and configure.
# For local development, instead set DB_CONNECTION=sqlite and comment out the DB_* lines below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=banglaychinese
DB_USERNAME=banglaychinese
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production: keep true when using HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue — the database driver backs SendEmailJob (all email delivery is queued).
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90
# Set true only if you later wrap email dispatch in database transactions.
DB_QUEUE_AFTER_COMMIT=false
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail settings — BREVO bootstrap configuration only
# ---------------------------------------------------------------------------
# Actual email delivery is handled by the database EmailProvider row named
# "Brevo SMTP" (see EmailService + SendEmailJob). These MAIL_* values are NOT
# used by the application at runtime and are NOT Hostinger mail credentials.
#
# They exist ONLY so that `php artisan db:seed` (EmailSystemSeeder) can create
# the initial Brevo provider row. Provide your REAL BREVO SMTP values here
# before the first seed; afterwards the credentials live encrypted in the
# `email_providers.config` column and can be edited in Filament.
#
# Do NOT put Hostinger e-mail credentials here. Hostinger only hosts the app,
# database and queue worker; when SendEmailJob runs on Hostinger it connects
# out to Brevo's SMTP using the stored provider configuration.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@banglaychinese.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
